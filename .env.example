DATABASE_URL=postgresql://pit_user:pit_pass@localhost:5432/pit_db
# REDIS_URL es OPCIONAL: si no la definís, el backend usa memoria RAM automáticamente
# (mismo comportamiento, sin caídas por ECONNREFUSED). Definila solo si tenés Redis real.
REDIS_URL=
JWT_SECRET=cambia_esto_en_produccion
# ⚠️ OBLIGATORIA en producción: si NODE_ENV=production y esta variable no está
# configurada, el servidor se niega a arrancar (fail-fast) en vez de usar un
# secret inseguro por defecto. Generá un valor random largo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
PORT=3000
# FRONTEND_URL es OPCIONAL: si la definís (ej: https://pit.vercel.app), CORS se
# restringe a ese origen. Si la dejás vacía, el backend acepta cualquier origen
# (comportamiento actual, para no romper nada mientras probás).
FRONTEND_URL=
# WEBAUTHN_RP_ID es OPCIONAL: si no la definís, se deriva de FRONTEND_URL.
# Debe ser el dominio real donde corre el frontend (sin https:// ni puerto),
# ej: pit.vercel.app. Necesaria para que el bloqueo biométrico funcione en producción.
WEBAUTHN_RP_ID=
OPENAI_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ADMIN_SECRET=cambia_esto_por_una_clave_larga_random
# ⚠️ OBLIGATORIA en producción: cifra el contenido de los mensajes en reposo
# (AES-256-GCM). Sin esto, el servidor se niega a arrancar en producción.
# Generá un valor con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=
